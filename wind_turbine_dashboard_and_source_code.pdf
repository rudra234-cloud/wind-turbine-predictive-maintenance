<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wind Turbine Predictive Maintenance Dashboard</title>
<style>
body{font-family:Arial,sans-serif;margin:0;padding:16px;background:#f4f6f8;color:#222}
h1{font-size:20px;margin:0 0 4px}.sub{font-size:12px;color:#666;margin-bottom:12px}
.ctl{display:flex;flex-wrap:wrap;gap:14px;align-items:center;background:#fff;padding:10px;border-radius:8px;margin-bottom:12px;font-size:13px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:12px}
.k{background:#fff;border-radius:8px;padding:10px}.k b{display:block;font-size:20px;margin-top:4px}.k span{font-size:12px;color:#666}
#adv{padding:10px;border-radius:8px;margin-bottom:12px;font-size:14px}
.ok{background:#d9f2de}.warn{background:#fff0c9}.err{background:#fbd9d9}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:10px}
.c{background:#fff;border-radius:8px;padding:8px}.c div{font-size:12px;font-weight:bold;margin-bottom:4px}
canvas{width:100%;height:150px;display:block}
</style></head><body>
<h1>IoT Predictive Maintenance &amp; Wind Protection System</h1>
<div class="sub">Live interactive dashboard (software simulation). Works offline in any browser.</div>
<div class="ctl">
<label>Hours <input type="range" id="hrs" min="24" max="336" step="24" value="96"> <span id="hv">96</span></label>
<label>Seed <input type="number" id="seed" value="42" style="width:60px"></label>
<label><input type="checkbox" id="storm" checked> Storm event</label>
<label><input type="checkbox" id="fault" checked> Gearbox fault</label>
<label>Anomaly z <input type="range" id="z" min="2" max="5" step="0.5" value="3"> <span id="zv">3</span></label>
</div>
<div class="kpis" id="kpis"></div>
<div id="adv"></div>
<div class="grid" id="grid"></div>
<script>
const CUT_IN=3,RATED=12,WARN=20,CUT_OUT=25,RP=2000;
function rng(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function sim(h,seed,storm,fault,zl){
 const r=rng(seed),g=(s)=>s*Math.sqrt(-2*Math.log(r()+1e-12))*Math.cos(2*Math.PI*r());
 const n=h*6,D={wind:[],rpm:[],power:[],vib:[],temp:[],oil:[],health:[],anom:[],prot:[]};
 const sS=Math.floor(n*.7),fS=Math.floor(n*.6);
 for(let i=0;i<n;i++){
  let w=9+3*Math.sin(2*Math.PI*(h/24)*i/(n-1))+g(1.5);
  if(storm&&i>=sS&&i<sS+18)w+=8+12*(i-sS)/17;
  w=Math.min(35,Math.max(0,w));
  let rpm=Math.min(1,w/RATED)*16+g(.3);
  let p=w<CUT_IN?0:Math.min(RP,RP*Math.pow((w-CUT_IN)/(RATED-CUT_IN),3));
  const ramp=(fault&&i>=fS)?(i-fS)/(n-fS-1):0;
  let pr=w>=CUT_OUT?"EMERGENCY STOP":w>=WARN?"PITCH / DERATE":w<CUT_IN?"IDLE":"NORMAL";
  if(pr=="EMERGENCY STOP"){rpm=0;p=0}
  D.wind.push(w);D.rpm.push(rpm);D.power.push(p);D.prot.push(pr);
  D.vib.push(1.2+.05*rpm+2.5*ramp+g(.15));
  D.temp.push(45+.6*rpm+25*ramp+g(1.2));
  D.oil.push(4.5-1.2*ramp+g(.1));
 }
 const cl=(x)=>Math.min(1,Math.max(0,x));
 for(let i=0;i<n;i++){
  D.health.push(100*(1-(.4*cl((D.vib[i]-2)/3)+.35*cl((D.temp[i]-60)/30)+.25*cl((4-D.oil[i])/2))));
  let a=false;
  if(i>=12)for(const k of["vib","temp","oil"]){
   const s=D[k].slice(Math.max(0,i-36),i),m=s.reduce((x,y)=>x+y,0)/s.length;
   const sd=Math.sqrt(s.reduce((x,y)=>x+(y-m)*(y-m),0)/(s.length-1));
   if(sd>0&&Math.abs(D[k][i]-m)/sd>zl)a=true}
  D.anom.push(a)}
 return D}
function draw(id,title,y,color,unit,lines,an){
 let c=document.getElementById(id);
 if(!c){const d=document.createElement("div");d.className="c";d.innerHTML=`<div>${title} (${unit})</div><canvas id="${id}" width="640" height="300"></canvas>`;document.getElementById("grid").appendChild(d);c=document.getElementById(id)}
 const x=c.getContext("2d"),W=c.width,H=c.height,P=34;x.clearRect(0,0,W,H);
 let mn=Math.min(...y,...(lines||[]).map(l=>l[0])),mx=Math.max(...y,...(lines||[]).map(l=>l[0]));
 const pd=(mx-mn)*.08||1;mn-=pd;mx+=pd;
 const X=i=>P+(W-P-6)*i/(y.length-1),Y=v=>H-18-(H-28)*(v-mn)/(mx-mn);
 x.strokeStyle="#ddd";x.fillStyle="#666";x.font="11px Arial";
 for(let k=0;k<=4;k++){const v=mn+(mx-mn)*k/4,yy=Y(v);x.beginPath();x.moveTo(P,yy);x.lineTo(W-6,yy);x.stroke();x.fillText(v.toFixed(1),2,yy+4)}
 (lines||[]).forEach(l=>{x.strokeStyle=l[1];x.setLineDash([5,4]);x.beginPath();x.moveTo(P,Y(l[0]));x.lineTo(W-6,Y(l[0]));x.stroke();x.setLineDash([])});
 x.strokeStyle=color;x.lineWidth=1.2;x.beginPath();y.forEach((v,i)=>i?x.lineTo(X(i),Y(v)):x.moveTo(X(i),Y(v)));x.stroke();x.lineWidth=1;
 if(an){x.fillStyle="#000";y.forEach((v,i)=>{if(an[i]){x.beginPath();x.arc(X(i),Y(v),2.5,0,7);x.fill()}})}}
function run(){
 const h=+hrs.value,D=sim(h,+seed.value,storm.checked,fault.checked,+z.value),n=D.wind.length-1;
 hv.textContent=h;zv.textContent=z.value;
 const recent=D.anom.slice(-36).filter(Boolean).length,hl=D.health[n];
 kpis.innerHTML=[["Wind speed",D.wind[n].toFixed(1)+" m/s"],["Power",D.power[n].toFixed(0)+" kW"],["Health score",hl.toFixed(0)+" / 100"],["Protection state",D.prot[n]],["Anomalies (total)",D.anom.filter(Boolean).length]].map(a=>`<div class="k"><span>${a[0]}</span><b>${a[1]}</b></div>`).join("");
 let t,cls;
 if(hl<50||recent>10){t="Schedule maintenance immediately: gearbox degradation likely.";cls="err"}
 else if(hl<75||recent>3){t="Inspect within the next maintenance window.";cls="warn"}
 else{t="Turbine healthy. No action needed.";cls="ok"}
 adv.className=cls;adv.textContent="Maintenance advice: "+t;
 draw("c1","Wind speed",D.wind,"#1f77b4","m/s",[[WARN,"orange"],[CUT_OUT,"red"]]);
 draw("c2","Power output",D.power,"#2ca02c","kW");
 draw("c3","Vibration (dots = anomalies)",D.vib,"#d62728","mm/s",null,D.anom);
 draw("c4","Gearbox temperature",D.temp,"#ff7f0e","deg C");
 draw("c5","Oil pressure",D.oil,"#9467bd","bar");
 draw("c6","Health score",D.health,"#17becf","0-100")}
["hrs","seed","storm","fault","z"].forEach(i=>document.getElementById(i).addEventListener("input",run));
run();
</script></body></html>

endstream
endobj
